# Supabase Storage Configuration
# Get these values from: https://app.supabase.com → Your Project → Settings → API

# Your Supabase Project URL
# Get from: Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public Key
# Get from: Settings → API → anon public (safe to use in browser)
VITE_SUPABASE_ANON_KEY=eyJhbGc...your_key_here
SUPABASE_ANON_KEY=eyJhbGc...your_key_here

# Supabase Service Role Key (optional, for server-side operations)
# Get from: Settings → API → service_role secret (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your_service_role_key_here

# Storage Bucket Name (created in Supabase Storage dashboard)
# Should be public so files are accessible without authentication
SUPABASE_BUCKET_NAME=portfolio-files

