# Cloudflare R2 Configuration
# Get these values from: https://dash.cloudflare.com → Account Settings → API Tokens

# Your Cloudflare Account ID (visible in R2 URL: https://{ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=your_account_id_here

# R2 API Token ID (Access Key ID)
# Generated in Cloudflare Dashboard → API Tokens → Create Token
# Permissions: Object Storage → Edit (all buckets)
R2_API_TOKEN_ID=your_api_token_id_here

# R2 API Token Secret (Secret Access Key)
# Only visible once during token creation — save it securely
R2_API_TOKEN_SECRET=your_api_token_secret_here

# R2 Bucket name (created in R2 dashboard)
R2_BUCKET_NAME=portfolio-files
